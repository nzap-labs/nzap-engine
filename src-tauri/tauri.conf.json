{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NZAP Engine",
  "version": "0.1.0",
  "identifier": "com.nzaplabs.engine",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "NZAP Engine",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost blob:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Your own Google Colab runtimes, from a native window.",
    "longDescription": "NZAP Engine is an open-source desktop app that allocates and drives your own Google Colab runtimes (CPU, GPU and TPU): run code, open a terminal, manage files, run notebooks and ephemeral jobs — no server, no account, one install.",
    "copyright": "Copyright © NZAP Labs",
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "homepage": "https://github.com/nzap-labs/nzap-engine",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "NZAP Labs",
    "linux": {
      "deb": {
        "section": "devel",
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "release": "1",
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMzNDk3ODBCNEJGNTczQzIKUldUQ2MvVkxDM2hKdzY3aWR0S3dIWmQzZGlxbGZWeHZSUUp3RStLWDFqaVQ5VHlYVTdIcWFxckQK",
      "endpoints": [
        "https://github.com/nzap-labs/nzap-engine-releases/releases/latest/download/latest.json",
        "https://github.com/nzap-labs/nzap-engine/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "nzap"
        ]
      }
    }
  }
}
