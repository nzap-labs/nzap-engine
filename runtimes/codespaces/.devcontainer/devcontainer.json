// The NZAP Engine runtime for GitHub Codespaces.
//
// Publish this folder as the repository NZAP Engine creates codespaces from
// (default: nzap-labs/nzap-runtime; Settings → Compute providers can point
// at your own copy). The codespace serves a Jupyter Server on port 8888,
// which NZAP Engine reaches through GitHub's private port forwarding: only
// requests carrying the codespace owner's GitHub token get through.
{
  "name": "NZAP runtime",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  // Jupyter, ffmpeg (as on Colab), and /content: the working directory NZAP
  // jobs and apps use.
  "postCreateCommand": "python -m pip install --user --quiet --disable-pip-version-check jupyter_server ipykernel && sudo apt-get update -qq && sudo apt-get install -y -qq ffmpeg && sudo mkdir -p /content && sudo chown \"$(id -u):$(id -g)\" /content",
  // Started on every boot (codespaces stop when idle and start again on use).
  "postStartCommand": "nohup python -m jupyter server --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.root_dir=/ --IdentityProvider.token='' --ServerApp.allow_origin='*' --ServerApp.allow_remote_access=True --ServerApp.disable_check_xsrf=True > /tmp/nzap-jupyter.log 2>&1 &",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": { "label": "NZAP Jupyter", "onAutoForward": "silent" }
  },
  "hostRequirements": { "cpus": 2 }
}
